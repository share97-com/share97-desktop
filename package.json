{
  "name": "share97-desktop",
  "productName": "Share97 Desktop",
  "version": "1.7.0",
  "description": "Share97 Desktop: connect every social media account, run AI agent workers on a schedule and execute your Share97 workflows on this computer.",
  "author": {
    "name": "Share97",
    "email": "support@share97.com"
  },
  "homepage": "https://share97.com",
  "keywords": [
    "share97",
    "social-media-automation",
    "ai-agent",
    "browser-automation",
    "langchain",
    "electron"
  ],
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --experimental-strip-types --experimental-test-module-mocks \"src/**/*.test.ts\"",
    "dist": "electron-vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.share97.desktop",
    "productName": "Share97 Desktop",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**",
      "resources/**",
      "package.json"
    ],
    "icon": "resources/icon.png",
    "asar": false,
    "extraResources": [
      {
        "from": "share97-chrome",
        "to": "share97-chrome"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "share97-desktop-setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@langchain/core": "^1.3.6",
    "@langchain/langgraph": "^1.7.3",
    "@langchain/openai": "^1.8.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "langchain": "^1.6.3",
    "lucide-react": "^1.71.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "unpdf": "^1.9.1",
    "vite": "^8.3.7",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0"
  }
}
